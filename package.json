{
    "name": "looper",
    "version": "1.0.0",
    "private": true,
    "author": "John Olatubosun <toluolatubosun@gmail.com>",
    "scripts": {
        "postinstall": "patch-package",
        "build": "npx tsc && tsc-alias",
        "prisma:setup": "npx prisma migrate deploy && npx prisma generate",
        "start": "yarn build && yarn prisma:setup && node dist/src/index.js",
        "dev": "nodemon --ext ts,tsx,json --watch src --exec ts-node -r tsconfig-paths/register src/index.ts",
        "lint": "eslint src/**/*.{ts,tsx}",
        "run:script": "ts-node -r tsconfig-paths/register --script-mode"
    },
    "dependencies": {
        "@prisma/client": "^6.3.0",
        "@sentry/node": "^7.104.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "express": "^4.18.3",
        "express-async-errors": "^3.1.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "patch-package": "^8.0.0",
        "react": "^18.2.0",
        "spotify-web-api-node": "^5.0.2",
        "validator": "^13.12.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "^0.5.1",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/helmet": "^4.0.0",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.24",
        "@types/spotify-web-api-node": "^5.0.11",
        "@types/validator": "^13.12.2",
        "@typescript-eslint/eslint-plugin": "^7.1.0",
        "@typescript-eslint/parser": "^7.1.0",
        "eslint": "^8.57.0",
        "nodemon": "^3.1.0",
        "prisma": "^6.3.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.8",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}