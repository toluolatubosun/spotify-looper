<html>
<%- include('./partials/head.ejs') %>

    <body>
        <section class="bg-primary-2 h-screen flex flex-col">
            <div class="flex-1 text-primary-6 py-20 flex flex-col justify-center">
                <div class="container mx-auto px-4 text-center">
                    <h1
                        class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-primary-6 to-primary-4 bg-clip-text text-transparent mb-6 leading-tight pb-2">
                        Welcome to Looper!
                    </h1>
                    <p class="text-xl mb-8">
                        <span class="font-bold">Spotify</span> doesn't have a feature to let you <span
                            class="font-bold">loop a part of a
                            song</span>,
                        so I built one for you!
                    </p>
                    <div class="flex flex-col space-y-4 md:flex-row md:space-x-4 md:space-y-0 justify-center">
                        <a href="/login" class="inline-block">
                            <button
                                class="font-black tracking-wide text-primary-1 bg-primary-6 h-11 rounded-md px-8 flex items-center justify-center">
                                Get Started
                                <i data-lucide="arrow-right" class="ml-2 h-5 w-5"></i>
                            </button>
                        </a>
                    </div>
                    <div class="flex justify-center space-x-6 mt-6 text-primary-5">
                        <a href="mailto:toluolatubosun@gmail.com"
                            class="font-bold flex items-center hover:text-primary-6 transition-colors underline">
                            <i data-lucide="mail" class="mr-2 h-5 w-5"></i>
                            <span>Send me an email to gain access</span>
                        </a>
                        <a href="https://github.com/toluolatubosun/spotify-looper/" target="_blank"
                            class="font-bold flex items-center hover:text-primary-6 transition-colors underline">
                            <i data-lucide="github" class="mr-2 h-5 w-5"></i>
                            <span>View code on GitHub</span>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('./partials/footer.ejs') %>
        </section>
        <%- include('./partials/scripts.ejs') %>
    </body>

</html>